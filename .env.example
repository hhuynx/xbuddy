# Copy to .env and edit locally. Never commit .env or paste API keys into chat.

# Chat Completions-compatible endpoint. Include the provider's API path (often /v1).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# true only for an intentionally unauthenticated local service.
LLM_ALLOW_NO_KEY=false
# Bounded final-answer output; an incomplete-output retry can grow up to 24000.
LLM_MAX_OUTPUT_TOKENS=12000
LLM_TIMEOUT_SECONDS=90
# auto uses low for official DeepSeek Flash/V4-Pro; other providers keep their defaults.
# Optional explicit values: low, high, max; none disables thinking on official DeepSeek.
LLM_REASONING_EFFORT=auto

# Fuyao: obtain your own key from https://fuyao.aicubes.cn/admin
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=

# Optional iFinD MCP: fill the actual MCP endpoint, not its website/login page.
IFIND_MCP_URL=
IFIND_API_KEY=
IFIND_AUTH_HEADER=Authorization
IFIND_AUTH_PREFIX=Bearer
IFIND_TRANSPORT=streamable_http
# Enable only actual, reviewed read-only tool names returned by discovery.
IFIND_TOOL_ALLOWLIST=

# Probe settings. No market responses or credentials are written to the report.
PROBE_TIMEOUT_SECONDS=20
PROBE_SYMBOLS=600519.SH,000858.SZ

# Local Python UI; use 0.0.0.0 only in the intended deployment environment.
XBUDDY_HOST=127.0.0.1
XBUDDY_PORT=8080
XBUDDY_DATA_DIR=
XBUDDY_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
XBUDDY_COOKIE_SECURE=false

# Container-hosting provider and public URL can be selected later.
DEPLOYMENT_PROVIDER=
DEPLOYMENT_PUBLIC_URL=
# Optional split deployment. Empty database URL keeps existing SQLite history.
# Compose overrides these inside containers; local PyCharm defaults remain unchanged.
XBUDDY_DATABASE_URL=
XBUDDY_REDIS_URL=
XBUDDY_EMBEDDED_WORKER=true
XBUDDY_TOOL_CONCURRENCY=2
